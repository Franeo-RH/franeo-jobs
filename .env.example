# Base PostgreSQL (Neon) : copiez l'adresse de connexion de la branche "production"
DATABASE_URL="postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require"

# Adresse publique de l'app (utilisée dans les liens des e-mails)
APP_URL="https://jobs.franeo-rh.com"

# E-mails (Resend) : facultatif, sans clé l'app fonctionne mais n'envoie aucun mail
RESEND_API_KEY=""
MAIL_FROM="Franeo Jobs <jobs@franeo-rh.com>"
MAIL_ADMIN="lfranchino@franeo-rh.com"

# Sécurise les tâches automatiques de nuit (Vercel l'envoie tout seul)
CRON_SECRET="une-longue-phrase-secrete"

# Mot de passe du premier compte administrateur créé par "npm run seed"
ADMIN_EMAIL="lfranchino@franeo-rh.com"
ADMIN_PASSWORD="ChangezMoi!2026"

# Stockage des CV dans Cloudflare R2 (10 Go gratuits). Laissez vide pour ranger les CV dans la base Neon.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="franeo-jobs-cv"
